+
+int
+fill_pstat(struct pstat *ps)
+{
+  struct proc *p;
+
+  for(int i = 0; i < NPROC; i++){
+    p = &proc[i];
+    acquire(&p->lock); // Trava o processo para ler dados consistentes
+    if(p->state != UNUSED){
+      ps->inuse[i] = 1;
+      ps->pid[i] = p->pid;
+      ps->tickets[i] = p->tickets;
+      ps->ticks[i] = p->ticks;
+    } else {
+      ps->inuse[i] = 0;
+    }
+    release(&p->lock);
+  }
+  return 0;
+}
